---
---
<div class="arch-diagram">
  <div class="arch-section arch-collection">
    <div class="arch-section-label">Data Collection <span class="arch-badge">Async</span></div>
    <div class="arch-row arch-cols-4">
      <div class="arch-node arch-source">
        <div class="arch-node-icon"><img src="/prometheus-logo.png" alt="Prometheus" class="arch-logo" /></div>
        <div class="arch-node-title">Prometheus</div>
        <div class="arch-node-desc">CPU, Memory, Network, Disk</div>
      </div>
      <div class="arch-node arch-source">
        <div class="arch-node-icon"><img src="/kubernetes-logo.png" alt="Kubernetes" class="arch-logo" /></div>
        <div class="arch-node-title">Kubernetes</div>
        <div class="arch-node-desc">Nodes, Pods, HPAs</div>
      </div>
      <div class="arch-node arch-source">
        <div class="arch-node-icon"><img src="/greenkube-logo.png" alt="OpenCost" class="arch-logo" /></div>
        <div class="arch-node-title">OpenCost</div>
        <div class="arch-node-desc">Cost Data</div>
      </div>
      <div class="arch-node arch-source">
        <div class="arch-node-icon"><img src="/eletricity-maps-logo.png" alt="Electricity Maps" class="arch-logo" /></div>
        <div class="arch-node-title">Electricity Maps</div>
        <div class="arch-node-desc">CO₂ Intensity</div>
      </div>
    </div>
  </div>

  <div class="arch-connector">
    <div class="arch-connector-line"></div>
    <div class="arch-connector-arrow">▼</div>
  </div>

  <div class="arch-section arch-processing">
    <div class="arch-section-label">Processing Engine</div>
    <div class="arch-row arch-cols-1">
      <div class="arch-node arch-processor">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div>
        <div class="arch-node-title">Data Processor</div>
        <div class="arch-node-desc">asyncio.gather orchestration</div>
      </div>
    </div>
    <div class="arch-connector-inner">
      <div class="arch-connector-line"></div>
      <div class="arch-connector-arrow">▼</div>
    </div>
    <div class="arch-row arch-cols-3">
      <div class="arch-node arch-module">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <div class="arch-node-title">Energy Estimator</div>
        <div class="arch-node-desc">Joules per pod</div>
      </div>
      <div class="arch-node arch-module">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
        <div class="arch-node-title">Zone Mapper</div>
        <div class="arch-node-desc">Region → Carbon Zone</div>
      </div>
      <div class="arch-node arch-module">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
        <div class="arch-node-title">Carbon Calculator</div>
        <div class="arch-node-desc">kWh × gCO₂/kWh</div>
      </div>
    </div>
    <div class="arch-connector-inner">
      <div class="arch-connector-line"></div>
      <div class="arch-connector-arrow">▼</div>
    </div>
    <div class="arch-row arch-cols-1">
      <div class="arch-node arch-combined">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
        <div class="arch-node-title">Combined Metrics</div>
        <div class="arch-node-desc">Energy + Carbon + Cost per pod</div>
      </div>
    </div>
  </div>

  <div class="arch-connector">
    <div class="arch-connector-line"></div>
    <div class="arch-connector-arrow">▼</div>
  </div>

  <div class="arch-section arch-output">
    <div class="arch-section-label">Output Layer</div>
    <div class="arch-row arch-cols-3">
      <div class="arch-node arch-storage">
        <div class="arch-node-icon"><img src="/postgres-logo.png" alt="Storage" class="arch-logo" /></div>
        <div class="arch-node-title">Storage</div>
        <div class="arch-node-desc">PostgreSQL · SQLite · Elasticsearch</div>
      </div>
      <div class="arch-node arch-api">
        <div class="arch-node-icon"><img src="/fastapi-logo.svg" alt="REST API" class="arch-logo" /></div>
        <div class="arch-node-title">REST API</div>
        <div class="arch-node-desc">FastAPI + OpenAPI</div>
      </div>
      <div class="arch-node arch-reco">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>
        <div class="arch-node-title">Recommender</div>
        <div class="arch-node-desc">Optimization Analysis</div>
      </div>
    </div>
  </div>

  <div class="arch-connector">
    <div class="arch-connector-line"></div>
    <div class="arch-connector-arrow">▼</div>
  </div>

  <div class="arch-section arch-presentation">
    <div class="arch-section-label">Presentation</div>
    <div class="arch-row arch-cols-3">
      <div class="arch-node arch-ui">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
        <div class="arch-node-title">Web Dashboard</div>
        <div class="arch-node-desc">SvelteKit SPA</div>
      </div>
      <div class="arch-node arch-ui">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></div>
        <div class="arch-node-title">CLI Reports</div>
        <div class="arch-node-desc">Typer + Rich</div>
      </div>
      <div class="arch-node arch-ui">
        <div class="arch-node-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
        <div class="arch-node-title">CSV / JSON Export</div>
        <div class="arch-node-desc">BI Integration</div>
      </div>
    </div>
  </div>
</div>

<style>
  .arch-diagram {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 2rem 0;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .arch-section {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    padding: 1.25rem;
    background: var(--sl-color-gray-6);
    position: relative;
  }

  .arch-section-label {
    position: absolute;
    top: -0.75rem;
    left: 1.25rem;
    background: var(--sl-color-gray-6);
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }

  .arch-badge {
    display: inline-block;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    padding: 0.1rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    margin-left: 0.375rem;
    text-transform: uppercase;
  }

  .arch-row {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
    align-items: stretch;
  }

  .arch-cols-1 { grid-template-columns: 1fr; max-width: 280px; margin-left: auto; margin-right: auto; }
  .arch-cols-3 { grid-template-columns: repeat(3, 1fr); }
  .arch-cols-4 { grid-template-columns: repeat(4, 1fr); }

  .arch-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    margin-top: 0 !important;
  }

  .arch-node:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }

  .arch-source { background: rgba(34, 197, 94, 0.06); border-color: rgba(34, 197, 94, 0.25); }
  .arch-processor { background: rgba(59, 130, 246, 0.06); border-color: rgba(59, 130, 246, 0.25); }
  .arch-module { background: rgba(168, 85, 247, 0.06); border-color: rgba(168, 85, 247, 0.2); }
  .arch-combined { background: rgba(245, 158, 11, 0.06); border-color: rgba(245, 158, 11, 0.25); }
  .arch-storage { background: rgba(6, 182, 212, 0.06); border-color: rgba(6, 182, 212, 0.25); }
  .arch-api { background: rgba(249, 115, 22, 0.06); border-color: rgba(249, 115, 22, 0.25); }
  .arch-reco { background: rgba(168, 85, 247, 0.06); border-color: rgba(168, 85, 247, 0.2); }
  .arch-ui { background: rgba(34, 197, 94, 0.06); border-color: rgba(34, 197, 94, 0.2); }

  .arch-node-icon {
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
  }

  .arch-node-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--sl-color-accent);
  }

  .arch-logo {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .arch-node-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sl-color-white);
    line-height: 1.2;
  }

  .arch-node-desc {
    font-size: 0.675rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.2rem;
    line-height: 1.3;
  }

  .arch-connector,
  .arch-connector-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.25rem 0;
  }

  .arch-connector-line {
    width: 2px;
    height: 12px;
    background: var(--sl-color-gray-4);
  }

  .arch-connector-arrow {
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .arch-cols-3,
    .arch-cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .arch-node {
      padding: 0.5rem 0.625rem;
    }
    .arch-node-icon { font-size: 1.25rem; }
    .arch-node-title { font-size: 0.7rem; }
    .arch-node-desc { font-size: 0.6rem; }
    .arch-section { padding: 1rem 0.75rem; }
  }
</style>
